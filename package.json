{
  "name": "seasonal-sandboxd",
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "private": true,
  "type": "module",
  "description": "SeasonalNet controlled execution daemon",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "token": "tsx src/cli.ts token"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
