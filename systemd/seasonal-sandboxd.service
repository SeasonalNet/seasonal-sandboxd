[Unit]
Description=Seasonal Sandbox Daemon
After=network-online.target mnt-seasonalnas.automount
Wants=network-online.target mnt-seasonalnas.automount

[Service]
Type=simple
User=sandboxd
Group=sandboxd
WorkingDirectory=/opt/seasonal-sandboxd
Environment=NODE_ENV=production
Environment=SEASONAL_SANDBOXD_CONFIG=/etc/seasonal-sandboxd/config.yaml
Environment=SQLITE3_BIN=/usr/bin/sqlite3
ExecStart=/usr/local/bin/node /opt/seasonal-sandboxd/dist/src/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sandboxd /mnt/seasonalnas/agent-workspaces/seasonal-sandboxd /mnt/seasonalnas/artifacts/seasonal-sandboxd
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
